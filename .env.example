# =====================================================================
# SYROTP server configuration
# Copy this file to .env and fill in values. NEVER commit .env.
# =====================================================================

# --- App ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgres://syrotp:syrotp_dev_password@localhost:5432/syrotp

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Crypto secrets (REQUIRED in production) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used to derive HMAC keys at rest. MUST be 64 hex chars (32 bytes).
MASTER_ENCRYPTION_KEY=replace_me_with_64_hex_chars_dev_only_do_not_use_in_production00

# Used to sign hosted-page session cookies. MUST be 64 hex chars.
COOKIE_SECRET=replace_me_with_64_hex_chars_dev_only_do_not_use_in_production00

# --- Verification policy ---
VERIFICATION_TTL_SECONDS=600
VERIFICATION_CODE_LENGTH=6
MAX_PENDING_PER_PHONE=3
MAX_PENDING_PER_IP=10

# --- Rate limits (token bucket) ---
RATE_LIMIT_START_PER_IP_PER_MIN=10
RATE_LIMIT_STATUS_PER_IP_PER_MIN=60
RATE_LIMIT_INBOUND_PER_RECEIVER_PER_MIN=120

# --- Inbound SMS / Receiver settings ---
RECEIVER_HEARTBEAT_TIMEOUT_SECONDS=120
INBOUND_TIMESTAMP_SKEW_SECONDS=300

# --- CORS (comma-separated origins, or * for dev only) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Trust proxy (set to true behind nginx/cloudflare) ---
TRUST_PROXY=false

# --- Admin dashboard (DISABLED BY DEFAULT) ---
# Leave both unset to disable the /admin/* routes entirely (404).
# Generate the scrypt password hash with:
#   pnpm --filter @syrotp/server run admin:hash
# Then paste the printed line into ADMIN_PASSWORD_HASH below.
# Full setup: docs/operations.md#3-configure-admin-auth
# ADMIN_USER=admin
# ADMIN_PASSWORD_HASH=scrypt$<saltHex>$<hashHex>

# --- Hosted verification page (ENABLED BY DEFAULT) ---
# Mounts GET /v/:id (HTML) + GET /v/:id/status (JSON polling) on the
# same Fastify server. The verification id is the auth token (ULID-
# style 128-bit; enumeration-safe). Set to false to refuse the routes.
HOSTED_PAGE_ENABLED=true

# --- Webhook delivery worker (ENABLED BY DEFAULT) ---
# Same-process periodic worker that scans webhook_deliveries for
# due+pending rows and POSTs the signed payload to each subscriber.
# The CRUD endpoints (/v1/webhooks) stay up either way — events
# still queue, just don't get delivered when the worker is off.
WEBHOOK_WORKER_ENABLED=true
# Tick interval in ms. Lower = lower delivery latency under low
# traffic, higher = lower DB pressure.
WEBHOOK_WORKER_INTERVAL_MS=5000

# --- WebAuthn fallback (DISABLED BY DEFAULT) ---
# Set WEBAUTHN_ENABLED=true to mount the four /v1/webauthn/* routes:
#   register/options, register/verify, login/options, login/verify
# All four are gated by sk_live_* keys. The cryptographic verify is
# delegated to @simplewebauthn/server.
# WEBAUTHN_ENABLED=true
# Relying-Party identifier — the eTLD+1 the credential is bound to.
# Required when enabled.
# WEBAUTHN_RP_ID=otp.example.com
# Optional human-readable RP name for browser UIs.
# WEBAUTHN_RP_NAME=Example
# Comma-separated origin allowlist. Every assertion / attestation
# response carries the origin it was created on; the server rejects
# any origin not in this list.
# WEBAUTHN_ORIGINS=https://otp.example.com,https://app.example.com
# Challenge TTL in seconds (single-use, expires_at-based).
WEBAUTHN_CHALLENGE_TTL_SECONDS=300
# Optional URL the hosted verification page links to as
# "use a passkey instead". When unset, no link appears. The page
# does NOT inline the WebAuthn flow itself in v0.5.
# WEBAUTHN_FALLBACK_URL=https://otp.example.com/passkey-fallback

# Phone-binding ceremony (v0.8 PR #36). How long a pending binding
# row stays valid before the developer has to restart the ceremony.
# 5 min is enough for the user to switch tabs, copy the SMS body,
# and send it; longer windows just widen the nonce-reuse risk
# surface.
PHONE_BINDING_TTL_SECONDS=300

# v0.8 PR #38 — per-app rate limits stacked on top of the per-IP /
# per-receiver buckets. Defaults are generous for legit multi-IP
# traffic but tight enough that a runaway app gets clamped before
# drowning the rest of the tenants.
RATE_LIMIT_VERIFICATIONS_PER_APP_PER_MIN=500
RATE_LIMIT_INBOUND_PER_APP_PER_MIN=1000
RATE_LIMIT_BINDINGS_PER_APP_PER_MIN=60
