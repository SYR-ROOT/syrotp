<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon the manifest requires.

  Without it AAPT fails: "resource mipmap/ic_launcher not found", so the module
  could not be built from a clean checkout.

  A vector in mipmap-anydpi resolves for every API level the module supports
  (minSdk 24), so no density-specific bitmaps are needed.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <path android:fillColor="#0F172A" android:pathData="M0,0h108v108h-108z" />
  <path
      android:fillColor="#38BDF8"
      android:pathData="M54,26L78,54L54,82L30,54Z" />
</vector>
