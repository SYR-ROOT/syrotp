<?xml version="1.0" encoding="utf-8"?>
<!-- Disallow cloud backup and device-to-device transfer of the gateway's
     encrypted shared prefs (which contain the signing key). Re-pair on a
     new device instead of carrying secrets across. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="syrotp_gateway_v1.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="syrotp_gateway_v1.xml" />
    </device-transfer>
</data-extraction-rules>
