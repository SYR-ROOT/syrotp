{
  "name": "@syrotp/server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "Muhammed Shekho",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./admin": "./dist/admin/index.js",
    "./admin/probe": "./dist/admin/probe.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:webhook": "tsx watch src/workers/webhook.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-views.mjs",
    "start": "node dist/index.js",
    "start:webhook": "node dist/workers/webhook.js",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx src/lib/aead.test.ts src/lib/crypto.test.ts src/lib/phone.test.ts src/services/matching.test.ts src/services/abuseSignals.test.ts",
    "test:integration": "node --test --import tsx test/integration.test.ts",
    "test:all": "pnpm test && pnpm test:integration"
  },
  "dependencies": {
    "@fastify/basic-auth": "^6.1.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/sensible": "^6.0.1",
    "@simplewebauthn/server": "^13.3.0",
    "drizzle-orm": "^0.36.0",
    "eta": "^3.5.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.1",
    "libphonenumber-js": "^1.11.12",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.3",
    "ulid": "^2.3.0",
    "undici": "^6.19.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
