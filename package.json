{
  "name": "syrotp",
  "version": "0.2.0",
  "private": true,
  "description": "Syrian Reverse OTP Protocol - monorepo root",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./apps/server\" build",
    "dev": "pnpm --filter @syrotp/server dev",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @syrotp/server test:integration",
    "test:all": "pnpm test && pnpm test:integration",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "smoke": "node scripts/smoke.mjs",
    "smoke:bootstrap": "docker compose exec -T server node dist/scripts/bootstrap.js --app-name smoke --msisdn +963998887777",
    "syrotp": "pnpm --filter @syrotp/cli start",
    "loadtest": "pnpm --filter @syrotp/loadtest start",
    "loadtest:quick": "pnpm --filter @syrotp/loadtest start scenario-a --workers 50 && pnpm --filter @syrotp/loadtest start replay-storm",
    "loadtest:all": "pnpm --filter @syrotp/loadtest start suite release-baseline",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1"
  }
}
