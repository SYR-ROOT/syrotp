# Flutter / Dart build artifacts
.dart_tool/
.flutter-plugins-dependencies
.metadata
build/

# Lockfile — this package is published as a library; downstream
# apps generate their own. The example here ships only source files
# (no platform scaffolding) so its lockfile is also disposable.
pubspec.lock
example/pubspec.lock

# Generated by `flutter create --platforms=...` if a developer wants
# to actually run the example locally. Not part of the published
# example.
example/android/
example/ios/
example/web/
example/macos/
example/linux/
example/windows/
