{
  "name": "@syrotp/react",
  "version": "0.1.0",
  "description": "React component for the Syrian Reverse OTP Protocol verification flow",
  "license": "MIT",
  "author": "Muhammed Sheko (SYR-ROOT)",
  "homepage": "https://github.com/SYR-ROOT/syrotp/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/SYR-ROOT/syrotp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SYR-ROOT/syrotp.git",
    "directory": "packages/react"
  },
  "keywords": [
    "syrotp",
    "otp",
    "sms",
    "verification",
    "reverse-otp",
    "react",
    "component",
    "ui",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
